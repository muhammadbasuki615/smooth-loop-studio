{
  "name": "Wallpaper Engine 1080p",
  "description": "Lightweight loop for Wallpaper Engine desktop wallpaper",
  "loop_options": {
    "mode": "ping_pong",
    "transition_seconds": 1.0,
    "blend_intensity": 1.0,
    "target_duration_seconds": 30,
    "output_fps": 30,
    "output_size": [1920, 1080]
  },
  "export_settings": {
    "container": "mp4",
    "codec": "h264",
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "bitrate": "4M",
    "audio_codec": "aac",
    "audio_bitrate": "128k",
    "use_gpu": true,
    "preset": "medium"
  }
}
